# Local development overrides.
# VITE_API_URL and VITE_SOCKET_URL are intentionally left unset here so that
# the fallback logic in src/services/api.js and src/context/TaskContext.jsx
# resolves to localhost:5000 in dev and relative /api in production.
# To point at a specific backend (e.g. Railway), set VITE_API_URL in the
# Vercel dashboard environment variables — do NOT set it here.
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
